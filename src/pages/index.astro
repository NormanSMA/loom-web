---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LoomCanvas } from '../components/LoomCanvas';
import { Navbar } from '../components/Navbar';
import { CarretReel } from '../components/CarretReel';
import { GlassWorkbench } from '../components/GlassWorkbench';
import { SignalRouter } from '../components/SignalRouter';
import { DownloadPortal } from '../components/DownloadPortal';
import { COPY, LINKS } from '../data/content';

const es = COPY.es;
const en = COPY.en;
---

<BaseLayout>
  <!-- Intro Preloader Curtain -->
  <div
    id="loom-intro"
    class="loom-curtain flex flex-col items-center justify-center gap-6 px-6"
    aria-hidden="true"
  >
    <div class="flex items-center gap-3">
      <span class="grid h-7 w-7 grid-cols-3 gap-1">
        <span class="rounded-xs bg-[var(--text-primary)] opacity-80" />
        <span class="rounded-xs bg-[var(--accent-blue)]" />
        <span class="rounded-xs bg-[var(--accent-green)]" />
        <span class="rounded-xs bg-[var(--accent-blue)]" />
        <span class="rounded-xs bg-[var(--text-primary)]" />
        <span class="rounded-xs bg-[var(--accent-blue)]" />
        <span class="rounded-xs bg-[var(--accent-green)]" />
        <span class="rounded-xs bg-[var(--accent-blue)]" />
        <span class="rounded-xs bg-[var(--text-primary)] opacity-80" />
      </span>
      <span class="font-mono text-sm tracking-[0.28em] text-[var(--text-primary)]">
        LOOM // TELAR
      </span>
    </div>
    <div class="w-56 space-y-2">
      <div class="h-0.5 w-full overflow-hidden rounded-full bg-[var(--dot-inactive)]">
        <div
          data-intro-bar
          class="h-full origin-left scale-x-0 bg-gradient-to-r from-[var(--accent-blue)] to-[var(--accent-green)]"
        />
      </div>
      <div class="flex justify-between font-mono text-[11px] text-[var(--text-muted)]">
        <span>URDIMBRE · 127.0.0.1</span>
        <span><span data-intro-progress>00</span>%</span>
      </div>
    </div>
  </div>

  <!-- Interactive Three.js Woven Loom WebGL Background -->
  <LoomCanvas client:only="react" />

  <!-- Floating Minimal Hairline Navigation -->
  <Navbar client:load />

  <main class="relative z-10">
    <!-- Hero Spatial Entry -->
    <section
      id="hero"
      data-hero
      class="relative mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-center px-4 pt-28 pb-16 sm:px-6"
    >
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.85fr)]">
        <div class="space-y-7">
          <div class="inline-flex min-h-9 items-center gap-2.5 rounded-full border border-[var(--border-hairline)] bg-[var(--bg-glass)] px-3.5 py-1 font-mono text-xs text-[var(--text-secondary)] backdrop-blur-md">
            <span class="h-2 w-2 rounded-full bg-[var(--accent-green)]" />
            <span data-i18n-es={es.hero.loopbackBadge} data-i18n-en={en.hero.loopbackBadge}>
              {es.hero.loopbackBadge}
            </span>
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-[var(--text-primary)] sm:text-6xl lg:text-7xl lg:leading-[1.02]">
            <span
              data-reveal="line"
              data-i18n-es={es.hero.line1}
              data-i18n-en={en.hero.line1}
              class="loom-clip-line block"
            >
              {es.hero.line1}
            </span>
            <span
              data-reveal="line"
              data-i18n-es={es.hero.line2}
              data-i18n-en={en.hero.line2}
              class="loom-clip-line block bg-gradient-to-r from-[var(--text-primary)] via-[var(--accent-blue)] to-[var(--accent-green)] bg-clip-text text-transparent"
            >
              {es.hero.line2}
            </span>
          </h1>

          <p
            data-reveal="line"
            data-i18n-es={es.hero.subtitle}
            data-i18n-en={en.hero.subtitle}
            class="loom-clip-line max-w-xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg"
          >
            {es.hero.subtitle}
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="#descargar"
              data-magnetic
              class="loom-magnetic inline-flex min-h-12 items-center gap-2 rounded-2xl bg-[var(--accent-blue)] px-6 text-sm font-semibold text-white shadow-lg shadow-blue-500/20 hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent-blue)]"
            >
              <span data-i18n-es={es.hero.primaryCta} data-i18n-en={en.hero.primaryCta}>
                {es.hero.primaryCta}
              </span>
              <span aria-hidden="true">-&gt;</span>
            </a>
            <a
              href="#carret-pin-host"
              data-magnetic
              class="loom-magnetic loom-glass-panel inline-flex min-h-12 items-center gap-2 rounded-2xl px-5 text-sm font-medium text-[var(--text-primary)] hover:border-[var(--border-strong)] focus-visible:outline-2 focus-visible:outline-[var(--accent-blue)]"
            >
              <span data-i18n-es={es.hero.secondaryCta} data-i18n-en={en.hero.secondaryCta}>
                {es.hero.secondaryCta}
              </span>
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-3">
            <span
              data-i18n-es={es.hero.toolsLabel}
              data-i18n-en={en.hero.toolsLabel}
              class="font-mono text-[11px] uppercase tracking-widest text-[var(--text-muted)]"
            >
              {es.hero.toolsLabel}
            </span>
            <div class="flex flex-wrap items-center gap-2">
              <img src="/brands/claude.svg" alt="Claude" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/codex.svg" alt="Codex" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/gemini.svg" alt="Gemini" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/antigravity.svg" alt="Antigravity" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/opencode.svg" alt="OpenCode" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/omniroute.svg" alt="OmniRoute" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/claudehub.png" alt="ClaudeHub" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/ollama.svg" alt="Ollama" class="h-6 w-6 rounded-md object-contain" />
              <img src="/brands/git.svg" alt="Git" class="h-6 w-6 rounded-md object-contain" />
            </div>
          </div>
        </div>

        <!-- Parallax Telemetry Capsule -->
        <aside
          data-parallax="-28"
          data-spotlight
          class="loom-glass-panel loom-spotlight hidden rounded-3xl p-6 lg:block"
        >
          <div class="flex items-center justify-between border-b border-[var(--border-hairline)] pb-4">
            <div class="flex items-center gap-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[var(--accent-green)]" />
              <span class="font-mono text-xs tracking-wider text-[var(--text-primary)]">
                LOOM_DAEMON // LIVE
              </span>
            </div>
            <span class="rounded-full bg-[var(--accent-blue-soft)] px-2.5 py-0.5 font-mono text-[11px] text-[var(--accent-blue)]">
              127.0.0.1:4320
            </span>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3 font-mono text-xs">
            <div class="rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 p-3.5">
              <p class="text-[10px] uppercase tracking-wider text-[var(--text-muted)]">RUST_CORE</p>
              <p class="mt-1 text-lg font-semibold text-[var(--text-primary)]">42/42 tests</p>
              <p class="mt-0.5 text-[11px] text-[var(--accent-green)]">0 warnings</p>
            </div>
            <div class="rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 p-3.5">
              <p class="text-[10px] uppercase tracking-wider text-[var(--text-muted)]">DESKTOP_UI</p>
              <p class="mt-1 text-lg font-semibold text-[var(--text-primary)]">Tauri v2</p>
              <p class="mt-0.5 text-[11px] text-[var(--accent-blue)]">Tray + Notch</p>
            </div>
            <div class="rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 p-3.5">
              <p class="text-[10px] uppercase tracking-wider text-[var(--text-muted)]">ISOLATION</p>
              <p class="mt-1 text-lg font-semibold text-[var(--text-primary)]">Git Worktree</p>
              <p class="mt-0.5 text-[11px] text-[var(--text-secondary)]">Zero collisions</p>
            </div>
            <div class="rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-surface)]/80 p-3.5">
              <p class="text-[10px] uppercase tracking-wider text-[var(--text-muted)]">BRIDGE</p>
              <p class="mt-1 text-lg font-semibold text-[var(--text-primary)]">ClaudeHub</p>
              <p class="mt-0.5 text-[11px] text-[var(--accent-amber)]">loom-runs.jsonl</p>
            </div>
          </div>

          <div class="mt-5 rounded-2xl border border-[var(--border-hairline)] bg-[var(--bg-void)]/70 px-4 py-3 font-mono text-[11px] text-[var(--text-secondary)]">
            <span class="text-[var(--accent-green)]">$</span> loom-cli route --role implementer --sensitivity confidential
          </div>
        </aside>
      </div>
    </section>

    <div id="carret-pin-host">
      <CarretReel client:load />
    </div>
    <GlassWorkbench client:load />
    <SignalRouter client:load />
    <DownloadPortal client:load />
  </main>

  <footer class="relative z-10 border-t border-[var(--border-hairline)] bg-[var(--bg-void)]/80 px-4 py-8 backdrop-blur-md sm:px-6">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-3 font-mono">
        <span class="text-[var(--text-primary)]">LOOM // TELAR</span>
        <span>·</span>
        <span>MIT © 2026 NormanSMA</span>
      </div>
      <div class="flex flex-wrap items-center gap-5 font-mono">
        <a href={LINKS.github} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)]">
          GitHub
        </a>
        <a href={LINKS.claudehub} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)]">
          ClaudeHub
        </a>
        <a href={LINKS.portfolio} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)]">
          nsma.dev
        </a>
      </div>
    </div>
  </footer>

  <script>
    import { initMotionEngine } from '../scripts/motion';

    const syncStaticCopy = (lang: 'es' | 'en') => {
      document.documentElement.lang = lang;
      const nodes = document.querySelectorAll<HTMLElement>('[data-i18n-es][data-i18n-en]');
      for (const el of nodes) {
        const next = lang === 'en' ? el.dataset.i18nEn : el.dataset.i18nEs;
        if (next) el.textContent = next;
      }
    };

    try {
      const saved = window.localStorage.getItem('loom.landing.lang');
      syncStaticCopy(saved === 'en' ? 'en' : 'es');
    } catch {
      syncStaticCopy('es');
    }

    window.addEventListener('loom:lang', (ev) => {
      const custom = ev as CustomEvent<'es' | 'en'>;
      if (custom.detail === 'es' || custom.detail === 'en') {
        syncStaticCopy(custom.detail);
      }
    });

    initMotionEngine();
  </script>
</BaseLayout>
