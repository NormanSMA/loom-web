---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LoomCanvas } from '../components/LoomCanvas';
import { Navbar } from '../components/Navbar';
import { CarretReel } from '../components/CarretReel';
import { GlassWorkbench } from '../components/GlassWorkbench';
import { SignalRouter } from '../components/SignalRouter';
import { DownloadPortal } from '../components/DownloadPortal';
import { COPY, LINKS } from '../data/content';

const es = COPY.es;
const en = COPY.en;
---

<BaseLayout>
  <!-- Intro Preloader Curtain -->
  <div
    id="loom-intro"
    class="loom-curtain flex flex-col items-center justify-center gap-6 px-6"
    aria-hidden="true"
  >
    <div class="flex items-center gap-3">
      <img src="/favicon.svg" alt="" class="h-7 w-7 shrink-0 rounded-lg" />
      <span class="font-mono text-sm tracking-[0.28em] text-[var(--text-primary)]">
        LOOM
      </span>
    </div>
    <div class="w-56 space-y-2">
      <div class="h-0.5 w-full overflow-hidden rounded-full bg-[var(--dot-inactive)]">
        <div
          data-intro-bar
          class="h-full origin-left scale-x-0 bg-gradient-to-r from-[var(--accent-blue)] to-[var(--accent-green)]"
        />
      </div>
      <div class="text-right font-mono text-[11px] text-[var(--text-muted)]">
        <span><span data-intro-progress>00</span>%</span>
      </div>
    </div>
  </div>

  <!-- Interactive Three.js Woven Loom WebGL Background -->
  <LoomCanvas client:only="react" />

  <!-- Floating Minimal Hairline Navigation -->
  <Navbar client:load />

  <main class="relative z-10">
    <!-- Hero Spatial Entry -->
    <section
      id="hero"
      data-hero
      class="relative mx-auto flex min-h-[100svh] max-w-4xl flex-col items-center justify-center gap-7 px-4 pt-28 pb-16 text-center sm:px-6"
    >
      <h1 class="text-4xl font-bold tracking-tight text-[var(--text-primary)] sm:text-6xl lg:text-7xl lg:leading-[1.02]">
        <span
          data-reveal="line"
          data-i18n-es={es.hero.line1}
          data-i18n-en={en.hero.line1}
          class="loom-clip-line block"
        >
          {es.hero.line1}
        </span>
        <span
          data-reveal="line"
          data-i18n-es={es.hero.line2}
          data-i18n-en={en.hero.line2}
          class="loom-clip-line block"
        >
          {es.hero.line2}
        </span>
      </h1>

      <p
        data-reveal="line"
        data-i18n-es={es.hero.subtitle}
        data-i18n-en={en.hero.subtitle}
        class="loom-clip-line max-w-xl text-base leading-relaxed text-[var(--text-secondary)] sm:text-lg"
      >
        {es.hero.subtitle}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <span
          data-i18n-es={es.hero.toolsLabel}
          data-i18n-en={en.hero.toolsLabel}
          class="font-mono text-[11px] uppercase tracking-widest text-[var(--text-muted)]"
        >
          {es.hero.toolsLabel}
        </span>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <img src="/brands/claude.svg" alt="Claude" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/codex.svg" alt="Codex" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/gemini.svg" alt="Gemini" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/antigravity.svg" alt="Antigravity" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/opencode.svg" alt="OpenCode" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/omniroute.svg" alt="OmniRoute" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/claudehub.png" alt="ClaudeHub" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/ollama.svg" alt="Ollama" class="h-6 w-6 rounded-md object-contain" />
          <img src="/brands/git.svg" alt="Git" class="h-6 w-6 rounded-md object-contain" />
        </div>
      </div>
    </section>

    <div id="carret-pin-host">
      <CarretReel client:load />
    </div>
    <GlassWorkbench client:load />
    <SignalRouter client:load />
    <DownloadPortal client:load />
  </main>

  <footer class="relative z-10 border-t border-[var(--border-hairline)] bg-[var(--bg-void)]/80 px-4 py-8 backdrop-blur-md sm:px-6">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-3 font-mono">
        <img src="/favicon.svg" alt="Loom" class="h-5 w-5 rounded-md" />
        <span class="text-[var(--text-primary)]">LOOM</span>
        <span>·</span>
        <span>MIT © 2026 NormanSMA</span>
      </div>
      <div class="flex flex-wrap items-center gap-5 font-mono">
        <a href={LINKS.github} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)]">
          GitHub
        </a>
        <a href={LINKS.claudehub} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)]">
          ClaudeHub
        </a>
        <a href={LINKS.portfolio} target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)]">
          nsma.dev
        </a>
      </div>
    </div>
  </footer>

  <script>
    import { initMotionEngine } from '../scripts/motion';

    const syncStaticCopy = (lang: 'es' | 'en') => {
      document.documentElement.lang = lang;
      const nodes = document.querySelectorAll<HTMLElement>('[data-i18n-es][data-i18n-en]');
      for (const el of nodes) {
        const next = lang === 'en' ? el.dataset.i18nEn : el.dataset.i18nEs;
        if (next) el.textContent = next;
      }
    };

    try {
      const saved = window.localStorage.getItem('loom.landing.lang');
      syncStaticCopy(saved === 'en' ? 'en' : 'es');
    } catch {
      syncStaticCopy('es');
    }

    window.addEventListener('loom:lang', (ev) => {
      const custom = ev as CustomEvent<'es' | 'en'>;
      if (custom.detail === 'es' || custom.detail === 'en') {
        syncStaticCopy(custom.detail);
      }
    });

    initMotionEngine();
  </script>
</BaseLayout>
