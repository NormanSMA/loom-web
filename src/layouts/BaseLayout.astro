---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Loom (Telar) — Orquestador local multiagente en Rust y Tauri v2',
  description = 'Coordina Claude Code, Codex, Gemini, Antigravity, OpenCode y OmniRoute en un plano local con Git worktrees aislados, PrivacyGate, PWA móvil y app de escritorio Tauri v2.',
} = Astro.props;

const canonicalUrl = 'https://loom.nsma.dev/';
const ogImageUrl = 'https://loom.nsma.dev/og-loom.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Loom (Telar)',
  alternateName: 'Loom Multi-Agent Orchestrator',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  license: 'https://opensource.org/licenses/MIT',
  url: canonicalUrl,
  codeRepository: 'https://github.com/NormanSMA/Loom',
  author: {
    '@type': 'Person',
    name: 'Norman Smith Martinez Acevedo',
    url: 'https://nsma.dev',
  },
  description,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050507" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="loom-dot-matrix min-h-screen bg-[var(--bg-void)] text-[var(--text-primary)] selection:bg-[var(--accent-blue-soft)] selection:text-[var(--text-primary)]">
    <slot />
  </body>
</html>
